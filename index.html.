// ================== BACKGROUND MUSIC ==================
let musicScheduler = null;
let musicPlaying = false;
let musicNoteIndex = 0;
let musicNextTime = 0;

const MELODY = [
  { note: 262, dur: 0.25 }, { note: 330, dur: 0.25 }, { note: 392, dur: 0.25 }, { note: 523, dur: 0.5 },
  { note: 392, dur: 0.25 }, { note: 523, dur: 0.25 }, { note: 659, dur: 0.5 }, { note: 587, dur: 0.25 },
  { note: 523, dur: 0.25 }, { note: 494, dur: 0.5 }, { note: 440, dur: 0.25 }, { note: 494, dur: 0.25 },
  { note: 523, dur: 0.75 }, { note: 0,   dur: 0.25 }, { note: 392, dur: 0.25 }, { note: 440, dur: 0.25 },
  { note: 494, dur: 0.25 }, { note: 523, dur: 0.5 }, { note: 659, dur: 0.25 }, { note: 587, dur: 0.25 },
  { note: 523, dur: 0.75 }, { note: 0,   dur: 0.5 }
];

const BASS = [
  { note: 131, dur: 0.5 }, { note: 131, dur: 0.5 }, { note: 165, dur: 0.5 }, { note: 165, dur: 0.5 },
  { note: 196, dur: 0.5 }, { note: 196, dur: 0.5 }, { note: 131, dur: 0.5 }, { note: 131, dur: 0.5 },
  { note: 175, dur: 0.5 }, { note: 175, dur: 0.5 }, { note: 196, dur: 0.5 }, { note: 196, dur: 0.5 },
  { note: 131, dur: 0.5 }, { note: 131, dur: 0.5 }, { note: 147, dur: 0.5 }, { note: 147, dur: 0.5 }
];

function scheduleMusic() {
  if (!musicPlaying || !audioCtx || !G.musicOn) return;
  const now = audioCtx.currentTime;
  if (musicNextTime < now) musicNextTime = now + 0.1;

  while (musicNextTime < now + 1) {
    const note = MELODY[musicNoteIndex % MELODY.length];
    if (note.note > 0) {
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = note.note;
        gain.gain.setValueAtTime(0.04, musicNextTime);
        gain.gain.exponentialRampToValueAtTime(0.001, musicNextTime + note.dur * 0.9);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(musicNextTime);
        osc.stop(musicNextTime + note.dur);
      } catch(e) {}
    }

    if (musicNoteIndex % 2 === 0) {
      const bassNote = BASS[Math.floor(musicNoteIndex / 2) % BASS.length];
      if (bassNote.note > 0) {
        try {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.value = bassNote.note;
          gain.gain.setValueAtTime(0.03, musicNextTime);
          gain.gain.exponentialRampToValueAtTime(0.001, musicNextTime + bassNote.dur * 0.9);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(musicNextTime);
          osc.stop(musicNextTime + bassNote.dur);
        } catch(e) {}
      }
    }

    musicNextTime += note.dur;
    musicNoteIndex++;
  }
}

function startMusic() {
  initAudio();
  if (!G.musicOn || !audioCtx) return;
  if (musicPlaying) return;
  musicPlaying = true;
  musicNoteIndex = 0;
  musicNextTime = audioCtx.currentTime + 0.1;
  if (musicScheduler) clearInterval(musicScheduler);
  musicScheduler = setInterval(scheduleMusic, 200);
  scheduleMusic();
}

function stopMusic() {
  musicPlaying = false;
  if (musicScheduler) { clearInterval(musicScheduler); musicScheduler = null; }
}

// ================== BACKGROUND ==================
let clouds = [];
let sunRays = 0;

function initBackground() {
  clouds = [];
  for (let i = 0; i < 6; i++) {
    clouds.push({
