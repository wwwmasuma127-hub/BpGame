}

function confettiRain() {
  const emojis = ['🎉', '🎊', '⭐', '✨', '🌟', '💫', '🎈', '🏆', '💖', '🎁', '🥳', '🎯'];
  for (let i = 0; i < 60; i++) {
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'confetti';
      el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      el.style.left = Math.random() * 100 + 'vw';
      el.style.fontSize = (20 + Math.random() * 30) + 'px';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 4500);
    }, i * 25);
  }
}

let shakeAmt = 0;
function screenShake(amount) { shakeAmt = amount; }

// ================== INPUT ==================
function getPointerPos(e) {
  const rect = canvas.getBoundingClientRect();
  let clientX, clientY;
  if (e.touches && e.touches.length) {
    clientX = e.touches[0].clientX;
    clientY = e.touches[0].clientY;
  } else if (e.changedTouches && e.changedTouches.length) {
    clientX = e.changedTouches[0].clientX;
    clientY = e.changedTouches[0].clientY;
  } else {
    clientX = e.clientX;
    clientY = e.clientY;
  }
  return { x: clientX - rect.left, y: clientY - rect.top };
}

function handlePointer(e) {
  if (G.state !== 'playing') return;
  e.preventDefault();
  initAudio();
  const pos = getPointerPos(e);

  for (let i = G.powerups.length - 1; i >= 0; i--) {
    const p = G.powerups[i];
    const dx = pos.x - p.x;
    const dy = pos.y - p.y;
    if (dx * dx + dy * dy < (p.radius + 15) * (p.radius + 15)) {
      applyPowerup(p.type);
      G.powerups.splice(i, 1);
      return;
    }
  }

  for (let i = G.balloons.length - 1; i >= 0; i--) {
    const b = G.balloons[i];
    if (b.popped) continue;
    const dx = (pos.x - b.x) / (b.radius * 1.1);
    const dy = (pos.y - b.y) / (b.radius * 1.2);
    if (dx * dx + dy * dy <= 1) {
      popBalloon(b);
      G.balloons.splice(i, 1);
      return;
    }
  }

  G.particles.push(new Particle(pos.x, pos.y, 'rgba(255,255,255,0.5)', {
    speed: 1, life: 20, size: 5, gravity: 0
  }));
}

canvas.addEventListener('mousedown', handlePointer);
canvas.addEventListener('touchstart', handlePointer, { passive: false });

// ================== LOOP ==================
let lastTime = 0;

function gameLoop(timestamp) {
  if (!lastTime) lastTime = timestamp;
  let dt = (timestamp - lastTime) / 16.67;
  lastTime = timestamp;
  dt = Math.min(dt, 3);

  if (G.state === 'playing') update(dt);
  render();
  requestAnimationFrame(gameLoop);
}

function update(dt) {
  G.elapsed += dt;
  G.levelTime += dt / 60;
  sunRays += 0.02 * dt;

  clouds.forEach(c => {
    c.x += c.speed * dt;
    if (c.x - c.size > W) c.x = -c.size;
  });

  characters.forEach(c => c.update(dt));

  spawnMusicNote();

  G.spawnTimer -= dt;
  if (G.spawnTimer <= 0) {
    const slowMo = G.activePowerups.slowMo > 0 ? 0.5 : 1;
    G.spawnTimer = G.spawnInterval * slowMo;
    spawnBalloon();
  }

  const slowMo = G.activePowerups.slowMo > 0 ? 0.5 : 1;
  for (let i = G.balloons.length - 1; i >= 0; i--) {
    const b = G.balloons[i];
    b.update(dt * slowMo);

    if (G.activePowerups.magnet > 0 && b.type !== 'bomb') {
      const dx = W/2 - b.x;
      const dy = H/2 - b.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist > 100) {
        b.x += (dx / dist) * 0.5 * dt;
        b.baseX = b.x;
      }
    }

    if (b.isOffScreen()) {
      G.balloons.splice(i, 1);
      if (b.type !== 'bomb') G.combo = 0;
    }
  }

  for (let i = G.powerups.length - 1; i >= 0; i--) {
    const p = G.powerups[i];
    p.update(dt * slowMo);
    if (p.y < -50 || p.life <= 0) G.powerups.splice(i, 1);
  }

  for (let i = G.particles.length - 1; i >= 0; i--) {
    G.particles[i].update(dt);
    if (G.particles[i].life <= 0) G.particles.splice(i, 1);
  }

  for (let i = G.popups.length - 1; i >= 0; i--) {
    G.popups[i].update(dt);
    if (G.popups[i].life <= 0) G.popups.splice(i, 1);
  }

  let needsUpdate = false;
  Object.keys(G.activePowerups).forEach(key => {
    if (G.activePowerups[key] > 0) {
      G.activePowerups[key] -= dt;
      needsUpdate = true;
      if (G.activePowerups[key] <= 0) G.activePowerups[key] = 0;
    }
  });
  if (needsUpdate) renderPowerupBar();

  if (G.comboTimer > 0) {
    G.comboTimer -= dt;
    if (G.comboTimer <= 0) G.combo = 0;
  }

  if (G.tutorialTimer > 0) G.tutorialTimer -= dt;

  if (shakeAmt > 0) {
    shakeAmt *= 0.85;
    if (shakeAmt < 0.5) shakeAmt = 0;
  }
}

function render() {
  ctx.save();
  if (shakeAmt > 0) {
    ctx.translate((Math.random() - 0.5) * shakeAmt, (Math.random() - 0.5) * shakeAmt);
  }

  drawBackground();

  if (G.state === 'playing' || G.state === 'paused' || G.state === 'won' || G.state === 'lost') {
    characters.forEach(c => c.draw(ctx));
    G.balloons.forEach(b => b.draw(ctx));
    G.powerups.forEach(p => p.draw(ctx));
    G.particles.forEach(p => p.draw(ctx));
    G.popups.forEach(p => p.draw(ctx));

    if (G.combo >= 3) {
      ctx.font = 'bold 26px -apple-system, "Segoe UI", Arial, sans-serif';
      ctx.textAlign = 'center';
      ctx.lineWidth = 6;
      ctx.strokeStyle = 'rgba(0,0,0,0.5)';
      const comboText = `${G.combo}x COMBO 🔥`;
      ctx.strokeText(comboText, W / 2, 130);
      ctx.fillStyle = '#FFD93D';
      ctx.fillText(comboText, W / 2, 130);
    }

    if (G.tutorialTimer > 0 && G.state === 'playing') {
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 28px -apple-system, "Segoe UI", Arial, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('POP THE BALLOONS!', W/2, H/2 - 60);
      ctx.font = '20px -apple-system, "Segoe UI", Arial, sans-serif';
      ctx.fillText('💣 Avoid the bomb!', W/2, H/2);
      ctx.fillText('⭐ Golden = 5x points!', W/2, H/2 + 40);
      ctx.fillText('❄️ Ice = 2x points!', W/2, H/2 + 80);
      ctx.fillText('❤️ Save your lives!', W/2, H/2 + 120);
    }
  }

  ctx.restore();
}

// ================== UI HANDLERS ==================
function showLevelSelect() {
  soundClick();
  const grid = document.getElementById('levelGrid');
  grid.innerHTML = '';
  LEVELS.forEach((level, i) => {
    const btn = document.createElement('button');
    const stageIdx = getStage(i);
    btn.className = 'level-btn stage-' + (stageIdx + 1);

    const stars = progress.levelStars[i] || 0;
    const stageData = STAGES[stageIdx];

    if (i >= progress.unlockedLevels) {
      btn.classList.add('locked');
      btn.innerHTML = `🔒<div class="stars">${i + 1}</div>`;
    } else {
      if (stars > 0) btn.classList.add('completed');
      btn.innerHTML = `${i + 1}<div class="stage-num">${stageData.emoji}</div><div class="stars">${'⭐'.repeat(stars)}</div>`;
      btn.onclick = () => {
        soundClick();
        startGame(i);
      };
    }
    grid.appendChild(btn);
  });
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById('levelScreen').classList.remove('hidden');
}

function showHowToPlay() {
  soundClick();
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById('howToScreen').classList.remove('hidden');
}

function showSettings() {
  soundClick();
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById('settingsScreen').classList.remove('hidden');
  updateSettingsUI();
}

function updateSettingsUI() {
  const sT = document.getElementById('soundToggle');
  sT.textContent = G.soundOn ? 'ON' : 'OFF';
  sT.className = 'btn small ' + (G.soundOn ? 'green' : 'yellow');
  const mT = document.getElementById('musicToggle');
  mT.textContent = G.musicOn ? 'ON' : 'OFF';
  mT.className = 'btn small ' + (G.musicOn ? 'green' : 'yellow');
}

function toggleSound() {
  G.soundOn = !G.soundOn;
  updateSettingsUI();
  if (G.soundOn) soundClick();
}

function toggleMusic() {
  G.musicOn = !G.musicOn;
  updateSettingsUI();
  if (G.musicOn && G.state === 'playing') startMusic();
  else stopMusic();
  soundClick();
}

function resetProgress() {
  if (confirm('All progress will be deleted. Are you sure?')) {
    progress = { unlockedLevels: 1, levelStars: {}, bestScores: {}, totalScore: 0, lastPlayedLevel: 0 };
    saveProgress();
    updatePlayButton();
    alert('Progress reset successfully!');
  }
}

document.getElementById('pauseBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  if (G.state === 'playing') pauseGame();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (G.state === 'playing') pauseGame();
    else if (G.state === 'paused') resumeGame();
  }
  if (e.key === ' ' && (G.state === 'playing' || G.state === 'paused')) {
    e.preventDefault();
    if (G.state === 'playing') pauseGame();
    else resumeGame();
  }
});

document.addEventListener('touchmove', (e) => {
  if (G.state === 'playing') e.preventDefault();
}, { passive: false });

// ================== CONTINUE / PLAY BUTTON ==================
function continueGame() {
  soundClick();
  initAudio();
  const lvl = Math.max(0, Math.min(progress.lastPlayedLevel || 0, LEVELS.length - 1));
  startGame(lvl);
}

function updatePlayButton() {
  const btn = document.getElementById('playBtn');
  if (!btn) return;
  const lvl = progress.lastPlayedLevel || 0;
  if (lvl > 0) {
    btn.textContent = '▶ CONTINUE LEVEL ' + (lvl + 1);
  } else {
    btn.textContent = '▶ PLAY NOW';
  }
}

// ================== INTRO SKIP ==================
function skipIntro() {
  soundClick();
  initAudio();
  document.getElementById('introScreen').classList.add('hidden');
  document.getElementById('startScreen').classList.remove('hidden');
  updatePlayButton();
}

// ================== INIT ==================
loadProgress();
resize();
initBackground();
updatePlayButton();
requestAnimationFrame(gameLoop);

// Safety: page close hone par bhi progress save ho jaye
window.addEventListener('beforeunload', () => {
  saveProgress();
});

setInterval(() => {
  if (clouds.length < 8 && Math.random() < 0.3) {
    clouds.push({
      x: -100,
      y: 50 + Math.random() * 200,
      size: 40 + Math.random() * 60,
      speed: 0.2 + Math.random() * 0.4
    });
  }
}, 3000);

