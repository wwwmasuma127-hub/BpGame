function getStage(levelIndex) { return Math.min(19, Math.floor(levelIndex / 10)); }
function getStageData(levelIndex) { return STAGES[getStage(levelIndex)]; }

// ================== GENERATE 200 LEVELS ==================
function generateLevels() {
  const levels = [];

  for (let i = 0; i < 200; i++) {
    const stageIdx = getStage(i);
    const stageLevel = i % 10;
    const stageData = STAGES[stageIdx];

    const target = Math.floor(200 + stageIdx * 400 + stageLevel * 80 + Math.pow(stageIdx, 1.5) * 100);
    const spawnInterval = Math.max(10, 50 - stageIdx * 1.8 - stageLevel * 0.8);
    const speedMult = 1.0 + stageIdx * 0.2 + stageLevel * 0.05;
    const levelLives = stageData.lives;

    let balloonTypes = ['red','blue','yellow','green'];
    if (stageIdx >= 1) balloonTypes.push('purple', 'orange');
    if (stageIdx >= 2) balloonTypes.push('pink');
    if (stageIdx >= 3) balloonTypes.push('cyan');
    if (stageIdx >= 4) balloonTypes.push('golden');
    if (stageIdx >= 5) balloonTypes.push('ice');
    if (stageIdx >= 6) balloonTypes.push('speed');
    if (stageIdx >= 7) balloonTypes.push('bomb');
    if (stageIdx >= 10) balloonTypes.push('bomb');
    if (stageIdx >= 14) balloonTypes.push('bomb');
    if (stageIdx >= 17) balloonTypes.push('bomb');

    levels.push({
      name: `Level ${i+1}`,
      stage: stageIdx,
      target,
      spawnInterval,
      speedMult,
      lives: levelLives,
      balloonTypes
    });
  }
  return levels;
}

