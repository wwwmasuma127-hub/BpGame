function drawBackground() {
  const stageIdx = (G.state === 'playing' || G.state === 'paused' || G.state === 'won' || G.state === 'lost') ? getStage(G.level) : 0;

  const skyGrad = ctx.createLinearGradient(0, 0, 0, H);

  const skyColors = [
    ['#87CEEB', '#FFE4B5'], ['#A8DADC', '#F1FAEE'], ['#FFB6C1', '#FFE4E1'],
    ['#FFD93D', '#FFA500'], ['#FF9F43', '#E67E22'], ['#FF6B6B', '#8B0000'],
    ['#C0392B', '#2C003E'], ['#48DBFB', '#0ABDE3'], ['#1DD1A1', '#006266'],
    ['#5F27CD', '#341F97'], ['#EE5A24', '#7F1D1D'], ['#009432', '#003300'],
    ['#C23616', '#2C003E'], ['#6F1E51', '#1A0025'], ['#1289A7', '#0652DD'],
    ['#F79F1F', '#B53471'], ['#D980FA', '#5F27CD'], ['#2C3E50', '#1A252F'],
    ['#EE5A24', '#000000'], ['#000000', '#1A1A1A']
  ];

  const colors = skyColors[Math.min(stageIdx, skyColors.length - 1)];
  skyGrad.addColorStop(0, colors[0]);
  skyGrad.addColorStop(1, colors[1]);
  ctx.fillStyle = skyGrad;
  ctx.fillRect(0, 0, W, H);

  const sunX = W - 100, sunY = 100;
  const sunGrad = ctx.createRadialGradient(sunX, sunY, 10, sunX, sunY, 100);
  if (stageIdx >= 5) {
    sunGrad.addColorStop(0, 'rgba(255,255,255,0.9)');
    sunGrad.addColorStop(1, 'rgba(255,255,255,0)');
  } else {
    sunGrad.addColorStop(0, 'rgba(255,255,200,0.9)');
    sunGrad.addColorStop(1, 'rgba(255,200,100,0)');
  }
  ctx.fillStyle = sunGrad;
  ctx.beginPath();
  ctx.arc(sunX, sunY, 100, 0, Math.PI * 2);
  ctx.fill();

  clouds.forEach(c => {
    ctx.fillStyle = stageIdx >= 5 ? 'rgba(100,100,150,0.5)' : 'rgba(255,255,255,0.85)';
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.size, 0, Math.PI * 2);
    ctx.arc(c.x + c.size * 0.8, c.y - c.size * 0.3, c.size * 0.7, 0, Math.PI * 2);
    ctx.arc(c.x - c.size * 0.8, c.y - c.size * 0.2, c.size * 0.6, 0, Math.PI * 2);
    ctx.fill();
  });

  if (stageIdx >= 9) {
    for (let i = 0; i < 30; i++) {
      const sx = (i * 137.5) % W;
      const sy = (i * 73.3) % (H * 0.6);
      const twinkle = Math.sin(sunRays * 3 + i) * 0.5 + 0.5;
      ctx.fillStyle = `rgba(255,255,255,${twinkle * 0.8})`;
      ctx.beginPath();
      ctx.arc(sx, sy, 1.5 + twinkle, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  const groundY = H - 80;
  const groundColors = [
    ['#7ED957', '#4CAF50'], ['#7ED957', '#4CAF50'], ['#D4A373', '#A0522D'],
    ['#F4A261', '#A0522D'], ['#C0392B', '#4A0000'], ['#4A0000', '#2A0000'],
    ['#2A0000', '#0A0000'], ['#0A5A6A', '#043A44'], ['#0A5A3A', '#033A24'],
    ['#3A1A5A', '#1A0030'], ['#5A2A0A', '#3A1A05'], ['#0A3A1A', '#052A10'],
    ['#3A0A0A', '#1A0000'], ['#3A0A2A', '#1A0015'], ['#0A2A5A', '#051A3A'],
    ['#5A3A0A', '#3A1A05'], ['#5A1A5A', '#2A0A2A'], ['#1A1A2A', '#0A0A15'],
    ['#2A1A0A', '#1A0A05'], ['#0A0A0A', '#000000']
  ];
  const gc = groundColors[Math.min(stageIdx, groundColors.length - 1)];

  const groundGrad = ctx.createLinearGradient(0, groundY, 0, H);
  groundGrad.addColorStop(0, gc[0]);
  groundGrad.addColorStop(1, gc[1]);
  ctx.fillStyle = groundGrad;
  ctx.beginPath();
  ctx.moveTo(0, groundY);
  for (let x = 0; x <= W; x += 20) {
    ctx.lineTo(x, groundY + Math.sin(x * 0.02 + sunRays) * 8);
  }
  ctx.lineTo(W, H);
  ctx.lineTo(0, H);
  ctx.closePath();
  ctx.fill();
}

// ================== BALLOON ==================
class Balloon {
  constructor() {
    const levelData = LEVELS[G.level] || LEVELS[0];
    const types = levelData.balloonTypes;
    this.type = types[Math.floor(Math.random() * types.length)];
    const data = BALLOON_TYPES[this.type];

    const baseSize = 28 + Math.random() * 12;
    this.radius = baseSize;

    this.x = this.radius + 20 + Math.random() * (W - 2 * this.radius - 40);
    this.y = H + this.radius + 20;

    const speed = (2.2 + Math.random() * 2.0) * levelData.speedMult * (data.special === 'speed' ? 1.8 : 1);
    this.vy = -speed;
    this.vx = (Math.random() - 0.5) * 1.5;

    this.data = data;
    this.wobble = Math.random() * Math.PI * 2;
    this.wobbleSpeed = 0.04 + Math.random() * 0.04;
    this.wobbleAmt = 3 + Math.random() * 5;
    this.baseX = this.x;
    this.popped = false;
    this.stringPhase = Math.random() * Math.PI * 2;

    this.faceEmoji = ['😊','😄','😁','🤗','😎','🥳','😺','🐶','🐰','🐼','🦊','🐯'][Math.floor(Math.random() * 12)];
  }

  update(dt) {
    this.wobble += this.wobbleSpeed * dt;
    this.y += this.vy * dt;
    this.x = this.baseX + Math.sin(this.wobble) * this.wobbleAmt;
    this.baseX += this.vx * dt;
    if (this.baseX < this.radius + 10 || this.baseX > W - this.radius - 10) {
      this.vx *= -1;
      this.baseX = Math.max(this.radius + 10, Math.min(W - this.radius - 10, this.baseX));
    }
  }

  isOffScreen() { return this.y + this.radius < -50; }

  draw(ctx) {
    const { x, y, radius, data } = this;

    ctx.fillStyle = 'rgba(0,0,0,0.1)';
    ctx.beginPath();
    ctx.ellipse(x, y + radius + 5, radius * 0.7, radius * 0.15, 0, 0, Math.PI * 2);
    ctx.fill();

    let glowColor = null;
    if (data.special === 'golden') glowColor = 'rgba(255,215,0,0.5)';
    else if (data.special === 'ice') glowColor = 'rgba(150,220,255,0.5)';
    else if (data.special === 'bomb') glowColor = 'rgba(255,0,0,0.3)';
    else if (data.special === 'speed') glowColor = 'rgba(255,50,50,0.4)';

    if (glowColor) {
      const glow = ctx.createRadialGradient(x, y, 0, x, y, radius * 1.7);
      glow.addColorStop(0, glowColor);
      glow.addColorStop(1, 'transparent');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(x, y, radius * 1.7, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.strokeStyle = 'rgba(100,100,100,0.6)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x, y + radius);
    for (let i = 0; i <= 20; i += 3) {
      const sx = x + Math.sin(this.stringPhase + i * 0.3) * 3;
      const sy = y + radius + i;
      if (i === 0) ctx.moveTo(sx, sy);
      else ctx.lineTo(sx, sy);
    }
    ctx.stroke();

    const grad = ctx.createRadialGradient(x - radius * 0.3, y - radius * 0.3, radius * 0.1, x, y, radius);
    grad.addColorStop(0, lighten(data.color, 40));
    grad.addColorStop(0.7, data.color);
    grad.addColorStop(1, data.color2);

    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.ellipse(x, y, radius * 0.85, radius, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.beginPath();
    ctx.ellipse(x - radius * 0.3, y - radius * 0.4, radius * 0.2, radius * 0.3, -0.3, 0, Math.PI * 2);
    ctx.fill();

    ctx.font = `bold ${radius * 0.9}px Arial`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    if (data.special === 'golden') ctx.fillText('⭐', x, y);
    else if (data.special === 'ice') ctx.fillText('❄️', x, y);
    else if (data.special === 'bomb') ctx.fillText('💣', x, y);
    else if (data.special === 'speed') ctx.fillText('⚡', x, y);
    else {
      ctx.font = `${radius * 0.75}px Arial`;
      ctx.fillText(this.faceEmoji, x, y);
    }

    ctx.fillStyle = data.color2;
    ctx.beginPath();
    ctx.moveTo(x - 4, y + radius * 0.9);
    ctx.lineTo(x + 4, y + radius * 0.9);
    ctx.lineTo(x, y + radius * 0.9 + 6);
    ctx.closePath();
    ctx.fill();
  }
}

function lighten(hex, amt) {
  const c = hexToRgb(hex);
  return `rgb(${Math.min(255, c.r + amt)},${Math.min(255, c.g + amt)},${Math.min(255, c.b + amt)})`;
}
function hexToRgb(hex) {
  return {
    r: parseInt(hex.slice(1,3), 16),
    g: parseInt(hex.slice(3,5), 16),
    b: parseInt(hex.slice(5,7), 16)
  };
}

// ================== PARTICLE ==================
class Particle {
  constructor(x, y, color, opts = {}) {
    this.x = x; this.y = y;
    const angle = opts.angle !== undefined ? opts.angle : Math.random() * Math.PI * 2;
    const speed = opts.speed !== undefined ? opts.speed : 2 + Math.random() * 4;
    this.vx = Math.cos(angle) * speed;
    this.vy = Math.sin(angle) * speed;
    this.color = color;
    this.life = opts.life || 40;
    this.maxLife = this.life;
    this.size = opts.size || 3 + Math.random() * 4;
    this.gravity = opts.gravity !== undefined ? opts.gravity : 0.15;
    this.shape = opts.shape || 'circle';
    this.rotation = Math.random() * Math.PI * 2;
    this.rotSpeed = (Math.random() - 0.5) * 0.3;
  }
  update(dt) {
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    this.vy += this.gravity * dt;
    this.vx *= 0.99;
    this.vy *= 0.99;
    this.life -= dt;
    this.rotation += this.rotSpeed * dt;
  }
  draw(ctx) {
    const alpha = Math.max(0, this.life / this.maxLife);
    ctx.globalAlpha = alpha;
    ctx.fillStyle = this.color;
    if (this.shape === 'star') {
      drawStar(ctx, this.x, this.y, 5, this.size, this.size * 0.5, this.rotation);
    } else if (this.shape === 'square') {
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rotation);
      ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size);
      ctx.restore();
    } else {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }
}

function drawStar(ctx, cx, cy, spikes, outerR, innerR, rot = 0) {
  let rotAngle = (Math.PI / 2) * 3 + rot;
  const step = Math.PI / spikes;
  ctx.beginPath();
  ctx.moveTo(cx, cy - outerR);
  for (let i = 0; i < spikes; i++) {
    ctx.lineTo(cx + Math.cos(rotAngle) * outerR, cy + Math.sin(rotAngle) * outerR);
    rotAngle += step;
    ctx.lineTo(cx + Math.cos(rotAngle) * innerR, cy + Math.sin(rotAngle) * innerR);
    rotAngle += step;
  }
  ctx.closePath();
  ctx.fill();
}

// ================== POPUP ==================
class ScorePopup {
  constructor(x, y, text, color = '#FFD93D') {
    this.x = x; this.y = y;
    this.text = text; this.color = color;
    this.life = 60; this.maxLife = 60;
    this.vy = -2.2; this.scale = 0;
  }
  update(dt) {
    this.y += this.vy * dt;
    this.vy *= 0.97;
    this.life -= dt;
    this.scale = Math.min(1, this.scale + 0.15 * dt);
  }
  draw(ctx) {
    const alpha = Math.max(0, this.life / this.maxLife);
    ctx.globalAlpha = alpha;
    ctx.font = `bold ${22 * this.scale}px -apple-system, 'Segoe UI', Arial, sans-serif`;
    ctx.textAlign = 'center';
    ctx.lineWidth = 4;
    ctx.strokeStyle = 'rgba(0,0,0,0.5)';
    ctx.strokeText(this.text, this.x, this.y);
    ctx.fillStyle = this.color;
    ctx.fillText(this.text, this.x, this.y);
    ctx.globalAlpha = 1;
  }
}

// ================== POWERUP ==================
class PowerUp {
  constructor(x, y, type) {
    this.x = x; this.y = y;
    this.type = type;
    this.data = POWERUP_TYPES[type];
    this.radius = 22;
    this.vy = -1.3;
    this.life = 400;
    this.wobble = 0;
  }
  update(dt) {
    this.y += this.vy * dt;
    this.wobble += 0.1 * dt;
    this.life -= dt;
  }
  draw(ctx) {
    const wobbleX = Math.sin(this.wobble) * 3;
    const x = this.x + wobbleX;
    const y = this.y;

    const glow = ctx.createRadialGradient(x, y, 0, x, y, this.radius * 2);
    glow.addColorStop(0, this.data.color + 'aa');
    glow.addColorStop(1, 'transparent');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(x, y, this.radius * 2, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(x, y, this.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = this.data.color;
    ctx.lineWidth = 4;
    ctx.stroke();

    ctx.font = `bold ${this.radius * 1.2}px Arial`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(this.data.emoji, x, y + 2);
  }
}

// ================== CHARACTERS ==================
class Character {
  constructor(x, y, emoji, speed = 0.5) {
    this.x = x; this.y = y;
    this.emoji = emoji;
    this.speed = speed;
    this.dir = 1;
    this.bob = Math.random() * Math.PI * 2;
  }
  update(dt) {
    this.bob += 0.05 * dt;
    this.x += this.speed * this.dir * dt;
    if (this.x < 60 || this.x > W - 60) this.dir *= -1;
  }
  draw(ctx) {
    const y = this.y + Math.sin(this.bob) * 5;
    ctx.font = '48px Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = 'rgba(0,0,0,0.1)';
    ctx.beginPath();
    ctx.ellipse(this.x, this.y + 28, 22, 7, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.save();
    ctx.translate(this.x, y);
    if (this.dir < 0) ctx.scale(-1, 1);
    ctx.fillText(this.emoji, 0, 0);
    ctx.restore();
  }
}

let characters = [];

// ================== GAME FLOW ==================
function startGame(levelIndex) {
  initAudio();
  if (levelIndex < 0) levelIndex = 0;
  if (levelIndex >= LEVELS.length) levelIndex = LEVELS.length - 1;

  G.level = levelIndex;

  // ✅ FIX: Save last played level so user can resume later
  progress.lastPlayedLevel = levelIndex;
  saveProgress();

  G.score = 0;
  G.combo = 0;
  G.comboTimer = 0;
  G.maxCombo = 0;
  G.balloons = [];
  G.particles = [];
  G.popups = [];
  G.powerups = [];
  G.spawnTimer = 0;
  G.elapsed = 0;
  G.levelTime = 0;
  G.activePowerups = { slowMo: 0, doublePoints: 0, magnet: 0 };
  G.tutorialTimer = (levelIndex === 0) ? 150 : 0;

  const levelData = LEVELS[levelIndex];
  G.targetScore = levelData.target;
  G.spawnInterval = levelData.spawnInterval;
  G.speedMult = levelData.speedMult;
  G.lives = levelData.lives;

  characters = [
    new Character(W * 0.15, H - 60, '🐰', 1.0),
    new Character(W * 0.35, H - 55, '🐻', 0.8),
    new Character(W * 0.5, H - 60, '🐱', 0.9),
    new Character(W * 0.65, H - 55, '🐶', 0.7),
    new Character(W * 0.85, H - 60, '🐼', 0.85)
  ];

  G.state = 'playing';

  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById('hud').style.display = 'flex';
  document.getElementById('pauseBtn').style.display = 'flex';
  document.getElementById('diffBadge').style.display = 'block';

  updateHUD();
  updateDifficultyBadge();
  startMusic();
}

function updateDifficultyBadge() {
  const stage = getStageData(G.level);
  const badge = document.getElementById('diffBadge');
  badge.textContent = `${stage.emoji} STAGE ${getStage(G.level) + 1}: ${stage.name}`;
  badge.style.background = `linear-gradient(145deg, ${stage.color}, ${stage.color2})`;
}

function endGame(won) {
  G.state = won ? 'won' : 'lost';
  stopMusic();
  document.getElementById('pauseBtn').style.display = 'none';
  document.getElementById('diffBadge').style.display = 'none';
  document.getElementById('powerupBar').innerHTML = '';

  if (won) {
    const stars = calculateStars();
    progress.levelStars[G.level] = Math.max(progress.levelStars[G.level] || 0, stars);
    progress.bestScores[G.level] = Math.max(progress.bestScores[G.level] || 0, G.score);
    progress.totalScore += G.score;

    if (G.level + 1 >= progress.unlockedLevels && G.level + 1 < LEVELS.length) {
      progress.unlockedLevels = G.level + 2;
    }

    // ✅ FIX: After winning, resume point = next level
    if (G.level + 1 < LEVELS.length) {
      progress.lastPlayedLevel = G.level + 1;
    }
    saveProgress();

    const nextStage = G.level + 1 < LEVELS.length ? getStage(G.level + 1) : null;
    const stageUp = nextStage !== null && nextStage !== getStage(G.level);

    document.getElementById('winEmoji').textContent = stars === 3 ? '🏆' : (stars === 2 ? '🎉' : '✨');
    document.getElementById('winTitle').textContent = `LEVEL ${G.level + 1} COMPLETE!`;

    let html = `
      <div><span class="label">Stars</span><span class="val">${'⭐'.repeat(stars)}${'☆'.repeat(3-stars)}</span></div>
      <div><span class="label">Score</span><span class="val">${G.score}</span></div>
      <div><span class="label">Target</span><span class="val">${G.targetScore}</span></div>
      <div><span class="label">Max Combo</span><span class="val">${G.maxCombo}x</span></div>
      <div><span class="label">Time</span><span class="val">${Math.floor(G.levelTime)}s</span></div>
    `;

    if (stageUp) {
      const ns = STAGES[nextStage];
      html += `<div style="margin-top:10px; padding:10px; background:linear-gradient(145deg, ${ns.color}, ${ns.color2}); border-radius:12px; color:#fff; border:none;">
        <span class="label" style="color:#fff;">STAGE UP!</span>
        <span class="val" style="color:#fff;">${ns.emoji} ${ns.name}</span>
      </div>`;
    }

    document.getElementById('winStats').innerHTML = html;

    const nextBtn = document.getElementById('nextLevelBtn');
    if (G.level + 1 < LEVELS.length) {
      nextBtn.style.display = 'block';
      nextBtn.textContent = stageUp ? `🎊 START STAGE ${nextStage + 1}` : '➡ NEXT LEVEL';
    } else {
      nextBtn.style.display = 'none';
    }

    document.getElementById('winScreen').classList.remove('hidden');
    soundWin();
    confettiRain();
  } else {
    // LOST
    if (G.level + 1 >= progress.unlockedLevels && G.level + 1 < LEVELS.length) {
      progress.unlockedLevels = G.level + 2;
    }

    // ✅ FIX: After losing, resume point = same level (so they can retry)
    progress.lastPlayedLevel = G.level;
    saveProgress();

    const nextStage = G.level + 1 < LEVELS.length ? getStage(G.level + 1) : null;
    const stageUp = nextStage !== null && nextStage !== getStage(G.level);

    let html = `
      <div><span class="label">Score</span><span class="val">${G.score}</span></div>
      <div><span class="label">Target</span><span class="val">${G.targetScore}</span></div>
      <div><span class="label">Missing</span><span class="val">${Math.max(0, G.targetScore - G.score)}</span></div>
      <div><span class="label">Max Combo</span><span class="val">${G.maxCombo}x</span></div>
    `;

    if (G.level + 1 < LEVELS.length) {
      html += `<div style="margin-top:10px; padding:10px; background:rgba(84,160,255,0.15); border-radius:12px; font-size:0.9em;">
        <span class="label" style="color:#34495e;">💡 Tip</span>
        <span class="val" style="color:#2e86de;">Try again to earn ⭐ stars!</span>
      </div>`;
    }

    document.getElementById('loseStats').innerHTML = html;

    const loseNextBtn = document.getElementById('loseNextBtn');
    if (G.level + 1 < LEVELS.length) {
      loseNextBtn.style.display = 'block';
      loseNextBtn.textContent = stageUp ? `🎊 START STAGE ${nextStage + 1}` : '➡ SKIP TO NEXT LEVEL';
    } else {
      loseNextBtn.style.display = 'none';
    }

    document.getElementById('loseScreen').classList.remove('hidden');
    soundLose();
  }
}

function calculateStars() {
  const ratio = G.score / G.targetScore;
  if (ratio >= 1.5) return 3;
  if (ratio >= 1.2) return 2;
  return 1;
}

function nextLevel() {
  soundClick();
  document.getElementById('winScreen').classList.add('hidden');
  const nextIdx = G.level + 1;
  if (nextIdx < LEVELS.length) {
    startGame(nextIdx);
  } else {
    backToMenu();
    setTimeout(() => alert('🎊 CONGRATULATIONS! You completed all 200 levels! 🎊'), 100);
  }
}

function nextLevelFromLose() {
  soundClick();
  document.getElementById('loseScreen').classList.add('hidden');
  const nextIdx = G.level + 1;
  if (nextIdx < LEVELS.length) {
    startGame(nextIdx);
  } else {
    backToMenu();
    setTimeout(() => alert('🎊 CONGRATULATIONS! You completed all 200 levels! 🎊'), 100);
  }
}

function restartLevel() {
  soundClick();
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  startGame(G.level);
}

function backToMenu() {
  soundClick();
  G.state = 'menu';
  stopMusic();
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById('startScreen').classList.remove('hidden');
  document.getElementById('hud').style.display = 'none';
  document.getElementById('pauseBtn').style.display = 'none';
  document.getElementById('diffBadge').style.display = 'none';
  document.getElementById('powerupBar').innerHTML = '';
  updatePlayButton();
}

function pauseGame() {
  if (G.state !== 'playing') return;
  G.state = 'paused';
  document.getElementById('pauseScreen').classList.remove('hidden');
  document.getElementById('pauseBtn').style.display = 'none';
}

function resumeGame() {
  soundClick();
  G.state = 'playing';
  document.getElementById('pauseScreen').classList.add('hidden');
  document.getElementById('pauseBtn').style.display = 'flex';
  initAudio();
  startMusic();
}

function updateHUD() {
  document.getElementById('hudScore').textContent = G.score;
  document.getElementById('hudLives').textContent = G.lives;
  document.getElementById('hudTarget').textContent = G.targetScore;
  document.getElementById('hudLevel').textContent = (G.level + 1);
}

// ================== SPAWNING ==================
function spawnBalloon() {
  G.balloons.push(new Balloon());
}

function spawnPowerup() {
  const types = Object.keys(POWERUP_TYPES);
  const type = types[Math.floor(Math.random() * types.length)];
  const x = 60 + Math.random() * (W - 120);
  G.powerups.push(new PowerUp(x, H + 40, type));
}

function applyPowerup(type) {
  soundPowerup();
  const data = POWERUP_TYPES[type];
  showComboPopup(data.emoji + ' ' + data.name + '!', '#FFD93D');
  if (type === 'extraLife') {
    G.lives++;
    updateHUD();
  } else {
    G.activePowerups[type] = data.duration;
    renderPowerupBar();
  }
}

function renderPowerupBar() {
  const bar = document.getElementById('powerupBar');
  bar.innerHTML = '';
  Object.keys(G.activePowerups).forEach(key => {
    if (G.activePowerups[key] > 0) {
      const el = document.createElement('div');
      el.className = 'powerup-item';
      el.innerHTML = `${POWERUP_TYPES[key].emoji} ${Math.ceil(G.activePowerups[key] / 60)}s`;
      bar.appendChild(el);
    }
  });
}

// ================== POP ==================
function popBalloon(balloon) {
  if (balloon.popped) return;
  balloon.popped = true;

  const { x, y, radius, data, type } = balloon;

  if (type === 'bomb') {
    soundBomb();
    G.lives--;
    G.combo = 0;
    updateHUD();
    for (let i = 0; i < 40; i++) {
      const angle = (i / 40) * Math.PI * 2;
      G.particles.push(new Particle(x, y, i % 2 === 0 ? '#FF4757' : '#FFA502', {
        angle: angle + Math.random() * 0.2,
        speed: 4 + Math.random() * 6,
        life: 40 + Math.random() * 30,
        size: 4 + Math.random() * 5,
        gravity: 0.2
      }));
    }
    screenShake(15);
    G.popups.push(new ScorePopup(x, y, '💥 BOOM!', '#FF4757'));
    if (G.lives <= 0) {
      setTimeout(() => endGame(false), 400);
    }
    return;
  }

  soundPop();
  G.combo++;
  G.comboTimer = 90;
  G.maxCombo = Math.max(G.maxCombo, G.combo);

  let points = data.points;
  const comboMult = 1 + Math.floor(G.combo / 5) * 0.5;
  points = Math.floor(points * comboMult);
  if (G.activePowerups.doublePoints > 0) points *= 2;

  G.score += points;
  updateHUD();

  const pCount = 12 + Math.floor(radius / 4);
  for (let i = 0; i < pCount; i++) {
    const angle = (i / pCount) * Math.PI * 2 + Math.random() * 0.3;
    G.particles.push(new Particle(x, y, Math.random() < 0.5 ? data.color : data.color2, {
      angle,
      speed: 2 + Math.random() * 4,
      life: 30 + Math.random() * 20,
      size: 3 + Math.random() * 4,
      gravity: 0.1
    }));
  }

  if (data.special === 'golden') {
    for (let i = 0; i < 15; i++) {
      G.particles.push(new Particle(x, y, '#FFD700', {
        angle: Math.random() * Math.PI * 2,
        speed: 2 + Math.random() * 5,
        life: 50,
        size: 5 + Math.random() * 4,
        shape: 'star',
        gravity: 0.05
      }));
    }
  } else if (data.special === 'ice') {
    for (let i = 0; i < 15; i++) {
      G.particles.push(new Particle(x, y, '#DFF9FB', {
        angle: Math.random() * Math.PI * 2,
        speed: 2 + Math.random() * 4,
        life: 40,
        size: 3 + Math.random() * 4,
        shape: 'square',
        gravity: 0.08
      }));
    }
  }

  const color = data.special === 'golden' ? '#FFD700' : (data.special === 'ice' ? '#48DBFB' : '#FFD93D');
  G.popups.push(new ScorePopup(x, y - radius, '+' + points, color));

  if (G.combo >= 5 && G.combo % 5 === 0) {
    showComboPopup(G.combo + 'x COMBO! 🔥', '#FF6B6B');
    soundCombo(G.combo);
  }

  if (Math.random() < 0.08 && type !== 'bomb') {
    spawnPowerup();
  }

  if (G.score >= G.targetScore) {
    setTimeout(() => endGame(true), 300);
  }
}

